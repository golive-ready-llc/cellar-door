# =========================================================================
# Cellar Door — docker compose configuration
#
#   cp .env.docker.example .env
#   # edit the two REQUIRED values below
#   docker compose up -d
#
# Only `docker compose` reads this file. For running the app outside a
# container, use .env.local instead (see .env.example).
# =========================================================================

# ---- REQUIRED ------------------------------------------------------------

# Postgres password for the bundled database container. Any strong string.
POSTGRES_PASSWORD=change-me-to-something-random

# Encrypts AI provider keys + Home Assistant tokens at rest.
# Generate with:  openssl rand -hex 32
# Must be exactly 64 hex characters.
ENCRYPTION_KEY=

# ---- AUTHENTICATION: pick ONE --------------------------------------------

# OPTION A - Single-user mode (simplest; no external services at all).
# Skips sign-in entirely and treats every request as the one local owner.
# Nothing to configure: no Google account, no Firebase project.
#
#   *** THIS DISABLES AUTHENTICATION. ***
#   Anyone who can reach the server has full access to your cellar. Use it on
#   a LAN/VPN, behind SITE_PASSWORD, or behind your own reverse-proxy auth -
#   never bare on the public internet.
#
# NOTE: compiled into the browser bundle, so changing it needs
#       `docker compose build`, not just a restart.
NEXT_PUBLIC_SINGLE_USER_MODE=true

# Strongly recommended alongside Option A:
# SITE_PASSWORD=some-shared-password


# OPTION B - Firebase (multi-user, real sign-in).
# Leave NEXT_PUBLIC_SINGLE_USER_MODE blank and fill these in instead.
#
# Authentication. Cellar Door currently uses Firebase Auth for sign-in;
# the free tier is more than enough for a personal instance.
# See SELF-HOSTING.md for the 4-step setup.
#
# NOTE: the NEXT_PUBLIC_* values are compiled into the browser bundle, so
# after changing any of them you must rebuild:  docker compose build
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase credentials (secrets).
# Either the whole service-account JSON on one line...
FIREBASE_SERVICE_ACCOUNT_KEY=
# ...or these two fields. Keep the \n escapes inside the private key.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# AI features (label scan, enrichment, sommelier chat). Bring your own key —
# you pay the provider directly. Without it the app still works as a manual
# wine tracker. More providers configurable in-app at /admin.
GEMINI_API_KEY=

# ---- OPTIONAL ------------------------------------------------------------

# Host port to publish the app on.
APP_PORT=3000

# Public URL of your instance. Used for Stripe redirects; set it if you put
# this behind a domain or reverse proxy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Unlocks every feature without configuring Stripe. Recommended for a
# personal instance. Values: FREE | PRO | PREMIUM
NEXT_PUBLIC_DEFAULT_TIER=PREMIUM

# Shared password in front of the whole site. Useful if you expose this
# beyond your LAN. Leave blank for no gate.
SITE_PASSWORD=

# Admin console (/admin) — set BOTH to the email you sign in with.
ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_EMAIL=

# Error tracking. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Contact form delivery. Leave RESEND_API_KEY blank and the landing-page
# contact form still logs submissions to the server; set it (free Resend
# account) to have messages emailed. CONTACT_EMAIL defaults to
# support@email242.com; CONTACT_FROM must be a Resend-verified sender.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM=

# Allow plain-HTTP Home Assistant URLs (trusted LAN only).
HA_ALLOW_HTTP=

# Database name/user for the bundled Postgres. Defaults are fine.
POSTGRES_DB=cellardoor
POSTGRES_USER=cellardoor
