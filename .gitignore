# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
nul

# Capacitor native builds (generated, large binaries)
# We commit android/ and ios/ project files but ignore build artifacts
android/app/build/
android/.gradle/
android/build/
android/capacitor-cordova-android-plugins/build/
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/

# Capacitor web assets copy (regenerated by cap sync)
android/app/src/main/assets/public/
ios/App/App/public/
.env*.local

# Local agent state (not for the repo — laptop-only)
.claude-flow/
.swarm/
.claude/agents/
.claude/commands/
.claude/skills/
.claude/helpers/
.claude/settings.json
.mcp.json

# Auto-generated tooling directories (Cline, Reason, etc.)
.codegraph/
.reasonix/
.agents/

# One-off lint/typecheck dump files captured during debugging
.lint-*.txt
.ts-*.txt

# One-off debug data dumps
enriched.json
*.tmp.json

# Common shell-output stubs that PowerShell creates from typos
void
void)
(null)
{,*
android/app/google-services.json
.claude/worktrees/

# PowerShell/pipe artifacts
,
\{
0
body\[f\]
test-*.cjs
test-*.mjs

# Operational/infra notes — deliberately NOT public (see SELF-HOSTING.md)
private/

# Project-internal handoff notes - not part of the AGPL-3.0 release.
# Backed up to golive-ready-llc/cellar-door-private.
handoff.md

# Local agent tooling state — never publish (contains local user paths)
.claude/settings.local.json
.mimosa/
.playwright-mcp/

# Scratch manifest generated during the Vercel bypass-deploy flow — not source.
.deploy-files.txt
