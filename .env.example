# =========================================================================
# Cellar Door — environment configuration
#
# Copy to `.env.local` and fill in. See SELF-HOSTING.md for a walkthrough.
# Sections are ordered by how much you need them:
#   1. REQUIRED     — the app will not boot without these
#   2. RECOMMENDED  — needed for the AI features that make the app useful
#   3. OPTIONAL     — payments, ads, monitoring, integrations
#   4. DEV/DEBUG    — local development conveniences
# =========================================================================


# -------------------------------------------------------------------------
# 1. REQUIRED
# -------------------------------------------------------------------------

# Postgres connection string. Any Postgres works; the hosted service uses
# Neon. For local dev: `postgresql://user:pass@localhost:5432/cellardoor`
# After setting this, run: npx prisma db push
DATABASE_URL="postgresql://cellardoor:cellardoor_dev@localhost:5432/cellardoor"

# Firebase Auth — client config. These are PUBLIC by design (they ship to
# the browser); they are not secrets. Create a Firebase project, enable
# Google + Email/Password sign-in, then copy these from Project Settings.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin — server-side credentials. THESE ARE SECRETS.
# Option 1 (single var, easiest on Vercel): the whole service-account JSON.
# FIREBASE_SERVICE_ACCOUNT_KEY='{"project_id":"...","client_email":"...","private_key":"..."}'
# Option 2: the two fields individually. Keep the \n escapes in the key.
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Encrypts secrets at rest (AI provider API keys, Home Assistant tokens)
# using AES-256-GCM. MUST be 64 hex characters (32 bytes).
#   Generate with: openssl rand -hex 32
# Use the SAME value everywhere that shares a database — values encrypted in
# one environment will not decrypt in another.
# If unset, those secrets are stored UNENCRYPTED. Do not ship without it.
ENCRYPTION_KEY=""


# -------------------------------------------------------------------------
# 1b. AUTHENTICATION MODE
#
# Leave blank for normal Firebase sign-in (multi-user).
#
# Set to "true" for a self-hosted PERSONAL instance: authentication is skipped
# entirely and every request is treated as one implicit local owner, created
# automatically on first boot. No Firebase project needed — none of the
# NEXT_PUBLIC_FIREBASE_* or FIREBASE_ADMIN_* values above are required.
#
#   *** THIS DISABLES AUTHENTICATION. ***
#   Anyone who can reach the server has full access. Use only on a LAN/VPN,
#   behind SITE_PASSWORD, or behind your own reverse-proxy auth. The server
#   logs a warning at startup if enabled without SITE_PASSWORD.
#
# Only the exact string "true" enables it. NEXT_PUBLIC_ values are inlined at
# BUILD time, so in Docker this must be a build arg, not just an env var.
NEXT_PUBLIC_SINGLE_USER_MODE=""


# -------------------------------------------------------------------------
# 2. RECOMMENDED — AI features
#
# Label scanning, invoice/wine-list extraction, enrichment, and the
# sommelier chat all need an AI provider. Without one, the app still works
# as a manual wine tracker but the AI surfaces are disabled.
#
# Providers are ALSO configurable at runtime in the in-app admin console
# (/admin), which stores per-provider keys encrypted in the database. This
# env var is the fallback/bootstrap for Gemini.
# -------------------------------------------------------------------------

GEMINI_API_KEY=""


# -------------------------------------------------------------------------
# 3. OPTIONAL
# -------------------------------------------------------------------------

# --- Admin console access (/admin) ---
# Email of the user allowed into the admin console. Both must match.
ADMIN_EMAIL=""
NEXT_PUBLIC_ADMIN_EMAIL=""

# --- Stripe subscriptions ---
# Only needed if you want paid tiers. Leave blank to run everything free —
# see NEXT_PUBLIC_DEFAULT_TIER below to unlock features without billing.
# NOTE: no publishable key is needed — checkout redirects to the URL of a
# server-created Stripe session, so Stripe.js never runs in the browser.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""              # Cellar+ monthly price ID
STRIPE_PRICE_PREMIUM=""          # Cellar Pro monthly price ID
STRIPE_PRICE_PRO_ANNUAL=""       # Cellar+ annual price ID
STRIPE_PRICE_PREMIUM_ANNUAL=""   # Cellar Pro annual price ID
STRIPE_PRICE_PRO_LEGACY=""       # (optional) retired price IDs, comma-separated
STRIPE_PRICE_PREMIUM_LEGACY=""   # (optional) retired price IDs, comma-separated

# --- Tier default ---
# Tier granted when there is no Stripe subscription. Set to PREMIUM on a
# self-hosted instance to unlock every feature without wiring up billing.
# Values: FREE | PRO | PREMIUM
NEXT_PUBLIC_DEFAULT_TIER=""

# --- Public site URL ---
# Where Stripe returns users after checkout / billing-portal sessions.
# Self-hosted: set this to YOUR domain or those redirects land on the
# hosted service instead of your instance.
NEXT_PUBLIC_SITE_URL=""

# --- Google AdSense (shown to FREE tier only, and only after cookie opt-in) ---
# Real ads serve only when the client ID AND the placement's slot ID are set;
# otherwise free-tier users see non-tracking house ads. Create one ad unit per
# placement in the AdSense dashboard and paste its slot ID below.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""       # e.g. ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=""     # ad-unit ID for the banner placement
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=""     # ad-unit ID for inline placements
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""    # ad-unit ID for the sidebar placement

# --- Cloudflare Turnstile (bot control for signup + contact forms) ---
# Privacy-friendly CAPTCHA. Both forms work without it (honeypot + rate limit
# still apply); set both keys to enable the bot gate. Free at
# https://dash.cloudflare.com → Turnstile → add a widget for your domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""      # public site key (0x...)
TURNSTILE_SECRET_KEY=""                # secret key — server-side verification

# --- Sentry error tracking ---
NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""            # only for source-map uploads at build time

# --- Site-wide password gate ---
# If set, the whole site sits behind this shared password. Useful for a
# private family instance or a staging deploy.
SITE_PASSWORD=""

# --- Same-origin Firebase auth helper ---
# Fixes Google sign-in loops on privacy-hardened browsers (Brave, LibreWolf,
# Safari ITP) by serving the auth helper from your own domain via /__/*.
# BEFORE enabling: add https://YOUR-DOMAIN/__/auth/handler to the OAuth web
# client's authorized redirect URIs in Google Cloud Console.
NEXT_PUBLIC_AUTH_SAME_ORIGIN=""

# --- Home Assistant (cellar temperature/humidity sensors) ---
# Allows plain-HTTP Home Assistant URLs. Only enable on a trusted LAN —
# HTTPS is required otherwise (the SSRF guard rejects http:// by default).
HA_ALLOW_HTTP=""

# --- Contact form (landing-page "Get in touch") ---
# Delivery for the /api/contact form is Microsoft Graph sendMail under an app
# registration (client-credentials, Mail.Send) — no third-party email provider.
# Without these set the endpoint still works: submissions are written to the
# server logs, just not emailed. Reuse the same Azure app registration as
# goliveready.com (same tenant, Mail.Send application permission, admin-consented).
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# A real mailbox in the tenant to send AS (e.g. support@goliveready.com).
GRAPH_SENDER=""
# Where contact-form messages are delivered. Defaults to GRAPH_SENDER.
CONTACT_EMAIL=""


# -------------------------------------------------------------------------
# 4. DEV / DEBUG
# -------------------------------------------------------------------------

# Run against in-memory mock data — no database or Firebase needed.
# The fastest way to see the UI: set this to "true" and `npm run dev`.
NEXT_PUBLIC_USE_MOCK=""

# Verbose auth logging in the browser console.
NEXT_PUBLIC_DEBUG_AUTH=""

# Build metadata surfaced in Settings. Normally set by CI, not by hand.
NEXT_PUBLIC_BUILD_VERSION=""
NEXT_PUBLIC_BUILD_SHA=""
